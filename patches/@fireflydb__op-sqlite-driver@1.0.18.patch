+ * Absolute path of the bundled libfirefly extension (platform suffix
+ * stripped — SQLite's `sqlite3_load_extension` re-appends it). Exposed so
+ * apps can `db.loadExtension(getLibraryPath(), getEntryPoint())` on their own
+ * op-sqlite connection without deep-importing the TurboModule spec.
+ */
+export function getLibraryPath(): string {
+  return FireflyClient.getLibraryPath();
+}
+
+/** Entry-point symbol for `sqlite3_load_extension` (`sqlite3_firefly_init`). */
+export function getEntryPoint(): string {
+  return FireflyClient.getEntryPoint();
